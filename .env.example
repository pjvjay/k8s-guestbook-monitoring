# Environment Configuration for SRE Deployment
# Copy this file to .env and configure your settings

# Pulumi Configuration (Required)
PULUMI_ACCESS_TOKEN=your-pulumi-token-here

# External Kubernetes Cluster Connection
# Choose ONE of the following methods:

# Method 1: Kubeconfig File (Most Common)
# KUBECONFIG_PATH=/path/to/your/kubeconfig

# Method 2: Direct Cluster Connection (URL + Token)
# K8S_CLUSTER_URL=https://your-cluster-url:6443
# K8S_CLUSTER_TOKEN=your-service-account-token
# K8S_CLUSTER_CA_DATA=base64-encoded-ca-certificate